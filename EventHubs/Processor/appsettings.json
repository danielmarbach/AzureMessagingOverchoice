{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Azure.Identity": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "EventHubs": {
    "Name": "temperaturechanged",
    "FullyQualifiedNamespace": "ndcosloeventhub1.servicebus.windows.net"
  },
  "SerializerOptions": {
    "SchemaGroup": "Schemas"
  },
  "StorageOptions": {
    "ServiceUri": "https://ndcosloeventhub1storage.blob.core.windows.net/",
    "ContainerName": "checkpoints"
  },
  "SenderOptions": {
    "ProduceData": true,
    "Storage": [
      "EE6AFD051F2F", "C67DB8FC86B6", "E70F6A4594B3", "039B202562A2", "4A7C1E9575D6"
    ],
    "NumberOfDataPointsPerChocolateStorage": 10000
  },
  "ProcessorOptions": {
    "NumberOfDataPointsToObserve": 10,
    "TemperatureThreshold": 25,
    "RestartFromBeginning": false,
    "UseKafka": false
  }
}